# Salin jadi .env lalu isi. File .env JANGAN di-commit.
NODE_ENV=production
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=12h
SENSOR_API_KEY=ganti-dengan-key-sensor
RESERVATION_HOLD_MINUTES=15

# Hanya untuk --profile token. Ambil dari Cloudflare Zero Trust > Networks > Tunnels > (tunnel) > Docker.
# Kosongkan kalau pakai --profile quick.
TUNNEL_TOKEN=
